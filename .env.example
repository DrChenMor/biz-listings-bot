# Copy to .env and fill in. Used when running the bots on your Mac (e.g. "Check SEEK.command").
SHEET_ID=your-sheet-id-or-link
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your-service-account-key.json

# The broker agent. It stays in test mode until AGENT_LIVE=yes: forms are filled but not sent, and no email leaves.
# AGENT_LIVE=yes
# ANTHROPIC_API_KEY=your-key
# GMAIL_ADDRESS=a-new-inbox-just-for-deals@gmail.com
# GMAIL_APP_PASSWORD=a-google-app-password-for-that-inbox
# BUYER_PROFILE={"name": "Your Name", "email": "a-new-inbox-just-for-deals@gmail.com", "phone": "0400000000", "postcode": "6000"}
# BUYER_SIGNATURE_FILE=/path/to/your-signature.png
